\keys_set:nn { siunitx } { redefine-symbols = true }
\AtBeginDocument
  {
    \bool_if:NT \l__siunitx_redefine_symbols_bool
      {
        \@ifpackageloaded { fourier }
          {
            \__siunitx_option_unchanged:Nnn \l__siunitx_ohm_text_tl
