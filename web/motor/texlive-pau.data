     \global\GPT@pagecolortrue
     \global\let\current@page@color\current@color
     \IfHookEmptyTF{shipout/background}{\AddToHook{shipout/background}{\relax}}{}%
    }%
    \g@addto@macro\@kernel@before@shipout@background
     {%
