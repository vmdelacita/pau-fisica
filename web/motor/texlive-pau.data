\ProvidesFile{il2lmr.fd}[2015/05/01 v1.6.1 Font defs for Latin Modern]
\DeclareFontFamily{IL2}{lmr}{}
\DeclareFontShape{IL2}{lmr}{m}{n}%
     {<-5.5>    cs-lmr5     <5.5-6.5> cs-lmr6
      <6.5-7.5> cs-lmr7     <7.5-8.5> cs-lmr8
      <8.5-9.5> cs-lmr9     <9.5-11>  cs-lmr10
      <11-15>   cs-lmr12
      <15-> cs-lmr17
