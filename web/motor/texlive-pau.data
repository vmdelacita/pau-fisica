\long\gdef\etb@dbg@trce#1{\typeout{%
  [debug] tracing \string#1\on@line}}%
\long\gdef\etb@dbg@init#1{\typeout{%
  [debug] analyzing '\detokenize\expandafter{\string#1}'}}%
