\newcommand\ldelim[2]{\@ifnextchar[{\@ldelim{#1}{#2}}{\@ldelim{#1}{#2}[0pt]}}
\def\@ldelim#1#2[#3]#4{\@ifnextchar[{\@@ldelim{#1}{#2}{#3}{#4}}{\@@ldelim{#1}{#2}{#3}{#4}[\null]}}
\def\@@ldelim#1#2#3#4[#5]%
 {\ifvoid\@arstrutbox\setbox\@arstrutbox\hbox{\strut}\fi
