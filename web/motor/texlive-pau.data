\let\origenddocument=\enddocument%
\def\enddocument{\clearpage%
  {\addtocounter{page}{-1}%
   \immediate\write\@mainaux{\string\newlabel{LastPage}{{}{\thepage}}}%
  }%
  \addtocounter{page}{+1}%
  \origenddocument%
