    \f@nch@fancyhf@Echeck{#2}%
    \f@nch@default\f@nch@@lcr{lcr}\temp@c
    \f@nch@default\f@nch@@hf{hf}{#3\temp@c}%
    \f@nch@forc\f@nch@eo\f@nch@@eo
